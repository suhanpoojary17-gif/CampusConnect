        <item name="android:windowLightStatusBar">true</item> <!-- Dark icons for white background -->
        <item name="colorOnSurface">#1C1B1A</item>

        <!-- Backgrounds -->
        <item name="android:windowBackground">@color/main_background</item>
        
        <!-- Canvas Text (Headings on background) -->
